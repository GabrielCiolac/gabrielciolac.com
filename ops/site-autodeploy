#!/bin/bash
# Pulls each app's image and redeploys its TrueNAS app when the image changes:
#   the site (nginx + static room) and the guestbook backend (PocketBase).
# Run by the deploy webhook after CI, and hourly by TrueNAS cron as a fallback.
set -euo pipefail
log() { logger -t site-autodeploy "$*"; }

exec 9>/run/site-autodeploy.lock
flock -n 9 || exit 0

# app name | image | container
APPS=(
  "gabrielciolac-site|ghcr.io/gabrielciolac/gabrielciolac.com:latest|ix-gabrielciolac-site-web-1"
  "gabrielciolac-pb|ghcr.io/gabrielciolac/gabrielciolac.com-pocketbase:latest|ix-gabrielciolac-pb-pb-1"
)

status=0
changed=0
for entry in "${APPS[@]}"; do
  IFS='|' read -r app image container <<<"$entry"
  if ! docker pull -q "$image" >/dev/null 2>&1; then
    log "pull failed for $image"; status=1; continue
  fi
  latest=$(docker image inspect -f '{{.Id}}' "$image")
  running=$(docker inspect -f '{{.Image}}' "$container" 2>/dev/null || echo none)
  if [ "$latest" != "$running" ]; then
    log "new image ${latest:7:12} (was ${running:7:12}); redeploying $app"
    if midclt call -j app.redeploy "\"$app\"" >/dev/null 2>&1; then
      log "redeploy ok: $app"; changed=1
    else
      log "redeploy FAILED: $app"; status=1
    fi
  fi
done

if [ "$changed" = 1 ]; then docker image prune -f >/dev/null 2>&1 || true; fi
exit "$status"
